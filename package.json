{
  "name": "@ovos-media/coding-standard",
  "version": "4.0.0",
  "description": "ovos-media coding standard: shared oxlint, oxfmt and prettier configuration",
  "homepage": "https://github.com/ovos/coding-standard",
  "license": "MIT",
  "author": "ovos",
  "repository": "https://github.com/ovos/coding-standard",
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./oxlint": {
      "types": "./dist/oxlint/index.d.ts",
      "default": "./dist/oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    },
    "./prettier": {
      "types": "./dist/prettier.d.ts",
      "default": "./dist/prettier.js"
    },
    "./plugins/*": {
      "types": "./dist/plugins/*.d.ts",
      "default": "./dist/plugins/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "npm run clean && npm run build && node --test 'dist/**/*.test.js'",
    "parity:update": "npm run build && UPDATE_SNAPSHOTS=1 node --test dist/parity.test.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-playwright": "^2.11.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-eslint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@types/node": "24.0.14",
    "@types/picomatch": "4.0.2",
    "picomatch": "4.0.3",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.18.0"
  }
}
